# Local development (the default if DATABASE_URL is omitted)
DATABASE_URL="file:./dev.db"
SQLITE_DATABASE_URL="file:./dev.db"

# Production runtime: use Neon's pooled PostgreSQL connection string.
# DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Migration/administration: use Neon's direct (non-pooler) connection string.
# Never expose either URL with a NEXT_PUBLIC_ prefix.
# POSTGRES_DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Optional Leaguepedia bot credentials. Rotate the previously shared password
# before putting the replacement in Vercel and GitHub secrets.
LP_BOT_USERNAME=""
LP_BOT_PASSWORD=""
